# Local/private files — not committed
# NOTE: this repo is PUBLIC. Anything listed here is world-readable the moment it is committed,
# so keep local paths, working notes and machine-specific config out of it.
# AGENT.md -- the agent/contributor guide. Carries local paths, machine-specific symlinks and
# working hypotheses, so it stays out of this public repo. It is versioned in the PRIVATE
# player repo instead (netradio_DNB_player, under docs/).
AGENT.md
.claude/
.env_vars
Archive/
audacity/
jaz_links
labels/tmp/

# Regenerable label scratch: the engine's per-file guesses (streamalign hints) and the
# neighbour seeds (streamalign starter / sort_tsv). Both are derived from the committed
# *.labels.tsv and must not reach the sheet or the solve -- keep them local.
labels/*.hints.tsv
labels/*.starter.labels.tsv
logo-tmp/
sources_local
TIM-ENV.md
tmp_o
tmp_t
tmp/

# streamalign / agent artifacts
__pycache__/
*.pyc
.context/
.venv/

# F1 skip-check clip output (default dir when NETRADIO_CLIPS_DIR unset)
clips_out/

# pre-sync safety backups written by scripts/tracklist_sync.sh before overwriting a working copy
*.presync-bak
.worktree

# Chroma signature cache. This is the point of the harvester -- the SIGNATURE outlives the audio
# (~55KB vs ~8MB) -- but it grows to gigabytes over a pool of any size, and it is regenerable.
# Keep it, never commit it.
.chroma-cache/
# Harvester runtime state (progress, matches, pause flag). Machine-local.
.harvest/
